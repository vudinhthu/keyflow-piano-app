{
  "name": "key-flow-piano",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/third-party-notices.mjs --check && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/browser-check.mjs",
    "test:pwa": "node scripts/pwa-check.mjs",
    "test:pwa-mobile": "node scripts/pwa-mobile-check.mjs",
    "samples:verify": "node scripts/verify-samples.mjs",
    "notices:generate": "node scripts/third-party-notices.mjs",
    "notices:verify": "node scripts/third-party-notices.mjs --check",
    "test:settings": "node scripts/settings-check.mjs",
    "test:offline": "node scripts/offline-check.mjs",
    "test:cache-atomic": "node scripts/cache-atomic-check.mjs",
    "test:offline-persistent": "node scripts/persistent-offline-check.mjs",
    "test:offline-ui": "node scripts/offline-ui-check.mjs",
    "test:journey": "node scripts/mvp-journey-check.mjs",
    "test:mvp": "node scripts/mvp-check.mjs",
    "test:performance": "node scripts/performance-check.mjs",
    "test:audio-lifecycle": "node scripts/audio-lifecycle-check.mjs",
    "test:memory": "node scripts/memory-check.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tone": "15.1.22",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/cli": "latest",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "1.2.0",
    "vitest": "^4.0.0",
    "workbox-precaching": "7.4.1"
  }
}
